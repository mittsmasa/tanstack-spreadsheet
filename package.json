{
  "name": "tanstack-spreadsheet",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "fnox exec -- vite dev --port 3210",
    "generate-routes": "tsr generate",
    "build": "fnox exec -- vite build",
    "preview": "fnox exec -- vite preview",
    "auth:migrate": "fnox exec -- pnpm dlx auth@1.7.2 migrate --config server/auth.ts",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.2",
    "@libsql/client": "0.17.4",
    "@libsql/kysely-libsql": "0.4.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-db": "0.3.6",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/store": "0.11.1",
    "better-auth": "1.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
